<!DOCTYPE html>
<html lang="pt-BR">
<head>
<meta charset="UTF-8">
<title>Calculadora de Painel de LED</title>
<style>
  body {
    font-family: Arial, sans-serif;
    background: #f2f2f2;
    padding: 20px;
    max-width: 900px;
    margin: auto;
  }
  h1, h2 { text-align: center; }
  label { display: block; margin-top: 10px; font-weight: bold; }
  input, select, button { width: 100%; padding: 8px; margin-top: 4px; }
  button { margin-top: 12px; font-size: 16px; cursor: pointer; border: none; }
  #calcular { background-color: #28a745; color: #fff; }
  #toggleCadastro { background-color: #ff9800; color: #fff; }
  .box { background: #fff; padding: 15px; margin-top: 20px; border-radius: 5px; }
  table { width: 100%; margin-top: 20px; border-collapse: collapse; background: #fff; }
  th, td { border: 1px solid #ccc; padding: 10px; text-align: center; }
  th { background: #ddd; }
  table tr:nth-child(even) { background-color: #f9f9f9; }
  canvas { display: block; margin: 20px auto; border:1px solid #333; }
</style>
</head>
<body>

<h1>Calculadora de Painel de LED</h1>

<div class="box">
  <h2>Tamanho do Painel (metros)</h2>

  <label>Largura (m)</label>
  <input type="number" id="painelLargura" step="0.01">

  <label>Altura (m)</label>
  <input type="number" id="painelAltura" step="0.01">

  <label>Modelo do painel</label>
  <select id="modelo"></select>

  <button id="calcular" onclick="calcular()">Calcular</button>
</div>

<button id="toggleCadastro" onclick="toggleCadastro()">➕ Adicionar painel</button>

<div class="box" id="cadastroPainel" style="display:none;">
  <h2>Cadastrar Novo Painel</h2>

  <label>Nome do painel</label>
  <input type="text" id="novoNome">

  <label>Largura da placa (cm)</label>
  <input type="number" id="novoLargura">

  <label>Altura da placa (cm)</label>
  <input type="number" id="novoAltura">

  <label>Resolução da placa (px largura)</label>
  <input type="number" id="novoPxL">

  <label>Resolução da placa (px altura)</label>
  <input type="number" id="novoPxA">

  <button onclick="adicionarPainel()">Adicionar painel</button>
</div>

<table>
  <tr>
    <th>Placas L</th>
    <th>Placas A</th>
    <th>Total</th>
  </tr>
  <tr>
    <td id="rPlacasL">-</td>
    <td id="rPlacasA">-</td>
    <td id="rTotal">-</td>
  </tr>
</table>

<table>
  <tr>
    <th>Tamanho Final (m)</th>
    <th>Resolução Final</th>
  </tr>
  <tr>
    <td id="rTamanho">-</td>
    <td id="rResolucao">-</td>
  </tr>
</table>

<table>
  <tr>
    <th>Área Total (m²)</th>
    <th>Densidade de Pixels (px/m²)</th>
  </tr>
  <tr>
    <td id="rArea">-</td>
    <td id="rDensidade">-</td>
  </tr>
</table>

<h2>Prévia do Painel</h2>
<canvas id="preview"></canvas>

<script>
let paineis = JSON.parse(localStorage.getItem('paineis')) || {};

function salvarLocalStorage() {
  localStorage.setItem('paineis', JSON.stringify(paineis));
}

function toggleCadastro() {
  const div = document.getElementById("cadastroPainel");
  div.style.display = div.style.display === "none" ? "block" : "none";
}

function atualizarSelect() {
  const select = document.getElementById("modelo");
  select.innerHTML = '<option value="">Selecione</option>';
  for (let nome in paineis) {
    const opt = document.createElement("option");
    opt.value = nome;
    opt.textContent = nome;
    select.appendChild(opt);
  }
}

function adicionarPainel() {
  const nome = novoNome.value.trim();
  const larguraCM = Number(novoLargura.value);
  const alturaCM = Number(novoAltura.value);
  const pxL = Number(novoPxL.value);
  const pxA = Number(novoPxA.value);

  if (!nome || !larguraCM || !alturaCM || !pxL || !pxA) {
    alert("Preencha todos os campos do painel");
    return;
  }

  paineis[nome] = {
    larguraMM: larguraCM * 10,
    alturaMM: alturaCM * 10,
    pxL, pxA
  };

  salvarLocalStorage();
  atualizarSelect();

  novoNome.value = "";
  novoLargura.value = "";
  novoAltura.value = "";
  novoPxL.value = "";
  novoPxA.value = "";

  toggleCadastro();
  alert("Painel cadastrado com sucesso!");
}

function calcular() {
  const larguraM = Number(painelLargura.value);
  const alturaM = Number(painelAltura.value);
  const modelo = document.getElementById("modelo").value;

  if (!larguraM || !alturaM || !modelo) {
    alert("Preencha o painel e selecione o modelo");
    return;
  }

  const painel = paineis[modelo];

  const placasL = Math.ceil((larguraM * 1000) / painel.larguraMM);
  const placasA = Math.ceil((alturaM * 1000) / painel.alturaMM);
  const total = placasL * placasA;

  const tamanhoFinalL = (placasL * painel.larguraMM / 1000).toFixed(2);
  const tamanhoFinalA = (placasA * painel.alturaMM / 1000).toFixed(2);

  const resolucaoL = placasL * painel.pxL;
  const resolucaoA = placasA * painel.pxA;

  const area = (tamanhoFinalL * tamanhoFinalA).toFixed(2);
  const densidade = Math.round((resolucaoL * resolucaoA) / area);

  rPlacasL.innerText = placasL;
  rPlacasA.innerText = placasA;
  rTotal.innerText = total;
  rTamanho.innerText = `${tamanhoFinalL} x ${tamanhoFinalA}`;
  rResolucao.innerText = `${resolucaoL} x ${resolucaoA}`;
  rArea.innerText = area;
  rDensidade.innerText = densidade;

  desenharPreview(placasL, placasA, painel);
}

function desenharPreview(placasL, placasA, painel) {
  const canvas = document.getElementById("preview");
  const ctx = canvas.getContext("2d");

  // Define tamanho máximo do canvas
  const maxWidth = 600;
  const maxHeight = 400;

  // Proporção real da placa
  const proporcaoPlaca = painel.alturaMM / painel.larguraMM;

  // Calcula altura e largura do canvas mantendo proporção
  let canvasWidth = maxWidth;
  let canvasHeight = canvasWidth * (placasA * painel.alturaMM) / (placasL * painel.larguraMM);

  if(canvasHeight > maxHeight){
    const scale = maxHeight / canvasHeight;
    canvasHeight = maxHeight;
    canvasWidth = canvasWidth * scale;
  }

  canvas.width = canvasWidth;
  canvas.height = canvasHeight;

  ctx.clearRect(0, 0, canvas.width, canvas.height);

  const larguraPlaca = canvas.width / placasL;
  const alturaPlaca = canvas.height / placasA;

  for(let i=0; i<placasL; i++){
    for(let j=0; j<placasA; j++){
      ctx.fillStyle = "#4CAF50";
      ctx.fillRect(i*larguraPlaca, j*alturaPlaca, larguraPlaca-2, alturaPlaca-2);
      ctx.strokeStyle = "#333";
      ctx.strokeRect(i*larguraPlaca, j*alturaPlaca, larguraPlaca-2, alturaPlaca-2);
    }
  }
}

// Inicializa select com LocalStorage
atualizarSelect();
</script>

</body>
</html>

